{
  "name": "anyone-login-wrong-password",
  "role": "anon",
  "demo": {
    "group": "sign-in",
    "as": "Any user",
    "title": "Wrong password at sign-in",
    "summary": "A staff member mistypes their password, sees the error, then signs in with the right one."
  },
  "setup": [
    { "as": "reception", "method": "GET", "path": "/auth/me", "expect": 200 }
  ],
  "steps": [
    { "goto": "/login" },
    { "caption": "Every staff member starts at the sign-in page." },
    { "fill": { "placeholder": "you@example.com" }, "value": "verify-reception@example.com" },
    { "fill": { "placeholder": "••••••••" }, "value": "wrong-password" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectApi": "POST /auth/login 401" },
    { "expectUrl": "/login" },
    { "expectText": "Invalid" },
    { "caption": "A wrong password shows an error and keeps you on this page." },
    { "caption": "Type the right password and sign in again." },
    { "fill": { "placeholder": "••••••••" }, "value": "verify-pass-reception" },
    { "click": { "role": "button", "name": "Sign in" } },
    { "expectApi": "POST /auth/login 201" },
    { "expectUrl": "/dashboard" },
    { "expectText": "Welcome" },
    { "caption": "Signed in. The app opens the first page for your role." }
  ]
}
