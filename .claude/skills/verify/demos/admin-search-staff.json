{
  "name": "admin-search-staff",
  "role": "admin",
  "demo": {
    "group": "admin",
    "title": "Search staff",
    "summary": "The admin filters the staff list to see who works in housekeeping."
  },
  "setup": [
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Hana Getachew", "role": "reception", "phone": "0919012345" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Bereket Tesfaye", "role": "security", "phone": "0920123456" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Liya Worku", "role": "housekeeping", "phone": "0921234567" }, "expect": 201 },
    { "as": "admin", "method": "POST", "path": "/staff", "body": { "name": "Samuel Abera", "role": "housekeeping", "phone": "0923456789" }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/staff" },
    { "expectApi": "GET /staff 200" },
    { "caption": "Search by name, role, phone, barcode or email." },
    { "fill": { "placeholder": "Search name, role, phone, barcode, email…" }, "value": "housekeeping" },
    { "expectText": "Liya Worku" },
    { "expectText": "Samuel Abera" },
    { "expectNoText": "Bereket Tesfaye" },
    { "caption": "Only the housekeeping team is left in the list." },
    { "caption": "A phone number works as well." },
    { "fill": { "placeholder": "Search name, role, phone, barcode, email…" }, "value": "0919012345" },
    { "expectText": "Hana Getachew" },
    { "expectNoText": "Liya Worku" },
    { "apiCheck": { "as": "admin", "path": "/staff", "jq": "any(.[]; .name == \"Liya Worku\" and .role == \"housekeeping\")" } }
  ]
}
