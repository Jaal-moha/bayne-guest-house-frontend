{
  "name": "payments-unpaid-status",
  "role": "reception",
  "setup": [
    { "as": "admin", "method": "POST", "path": "/rooms", "body": { "number": "P${RUN}", "type": "double", "price": 1500 }, "expect": 201, "save": "ROOM" },
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Payer ${RUN}", "phone": "0911223344" }, "expect": 201, "save": "GUEST" },
    { "as": "reception", "method": "POST", "path": "/bookings", "body": { "guestId": "${GUEST}", "roomId": "${ROOM}", "checkIn": "${DATE+40}", "checkOut": "${DATE+42}" }, "expect": 201, "save": "BOOKING" }
  ],
  "steps": [
    { "goto": "/payments" },
    { "click": { "role": "button", "name": "Record Payment" } },
    { "select": { "label": "Booking" }, "value": "${BOOKING}" },
    { "select": { "label": "Status" }, "value": "unpaid" },
    { "click": { "role": "button", "name": "Record" } },
    { "expectApi": "POST /payments 201" },
    { "expectHidden": "role=dialog" },
    { "screenshot": "unpaid-status" },
    { "apiCheck": { "as": "reception", "path": "/payments", "jq": "any(.[]; .bookingId == ${BOOKING} and .status == \"unpaid\")" } },
    { "expectNoPageErrors": true }
  ]
}
