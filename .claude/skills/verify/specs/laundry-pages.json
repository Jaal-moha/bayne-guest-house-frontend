  ],
  "steps": [
    {"goto": "/laundry"},
    {"expectApi": "GET /laundry 200"},
    {"fill": {"placeholder": "Search by guest, items, status…"}, "value": "${RUN}"},
    {"select": {"label": "Rows"}, "value": "20"},
    {"expectText": "Order 25 ${RUN}"},
    {"expectText": "Page 1 / 2"},
    {"expectNoText": "Order 01 ${RUN}"},
    {"click": {"role": "button", "name": "Next"}},
    {"expectText": "Page 2 / 2"},
    {"expectText": "Order 01 ${RUN}"},
    {"expectNoText": "Order 25 ${RUN}"},
    {"screenshot": "laundry-next"},
    {"apiCheck": {"as": "reception", "path": "/laundry", "jq": "[.[] | select(.guestId == ${GUEST})] | length == 25"}},
    {"click": {"role": "button", "name": "+ Add Laundry"}},
    {"select": {"label": "Guest"}, "value": "Pager ${RUN}"},
    {"fill": {"placeholder": "Item name"}, "value": "Shirts ${RUN}"},
    {"wait": 2000},
    {"expectValue": {"placeholder": "Item name"}, "value": "Shirts ${RUN}"},
    {"expectValue": {"label": "Guest"}, "value": "${GUEST}"},
    {"screenshot": "laundry-keep"},
    {"expectNoApi": "GET /laundry/"},
    {"expectNoPageErrors": true}
  ]
