{
  "name": "guests-edit-prefill",
  "role": "reception",
  "knownBug": "The guest row's Edit button opens an empty Add Guest form, so saving creates a duplicate.",
  "setup": [
    { "as": "reception", "method": "POST", "path": "/guests", "body": { "name": "Edit ${RUN}", "phone": "0911998877" }, "expect": 201 }
  ],
  "steps": [
    { "goto": "/guests" },
    { "click": "tr:has-text('Edit ${RUN}') >> role=button[name='Edit']" },
    { "expectValue": { "label": "Full name" }, "value": "Edit ${RUN}" }
  ]
}
