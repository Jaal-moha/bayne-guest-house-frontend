{
  "name": "staff-created-keeps-password",
  "role": "admin",
  "steps": [
    { "goto": "/staff" },
    { "click": { "role": "button", "name": "Add Staff" } },
    { "fill": { "label": "Full name" }, "value": "Pw ${RUN}" },
    { "select": { "label": "Role" }, "value": "reception" },
    { "fill": { "label": "Phone" }, "value": "0911000888" },
    { "fill": { "label": "Email" }, "value": "pw${RUN}@example.com" },
    { "click": { "role": "button", "name": "Continue" } },
    { "click": { "role": "button", "name": "Create Staff & Account" } },
    { "expectApi": "POST /staff 201" },
    { "expectText": "Staff created" },
    { "press": "Escape" },
    { "expectVisible": { "role": "dialog", "name": "Review & Create" } },
    { "expectText": "Password:" },
    { "screenshot": "password-kept" },
    { "click": { "label": "I saved the password" } },
    { "click": { "role": "button", "name": "Done" } },
    { "expectHidden": { "role": "dialog", "name": "Review & Create" } },
    { "expectText": "Pw ${RUN}" },
    { "expectNoPageErrors": true }
  ]
}
