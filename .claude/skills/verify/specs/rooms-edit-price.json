{
  "name": "rooms-edit-price",
  "role": "manager",
  "setup": [
    { "as": "manager", "method": "POST", "path": "/rooms", "body": { "number": "E${RUN}", "type": "single", "price": 900 }, "expect": 201, "save": "ROOM" }
  ],
  "steps": [
    { "goto": "/rooms" },
    { "click": "tr:has-text('E${RUN}') >> role=button[name='Edit']" },
    { "expectValue": { "placeholder": "Number" }, "value": "E${RUN}" },
    { "fill": { "placeholder": "Price (e.g. 75)" }, "value": "1100" },
    { "click": { "role": "button", "name": "Save Changes" } },
    { "expectApi": "PATCH /rooms/${ROOM} 200" },
    { "expectText": "ETB\u00a01,100.00" },
    { "apiCheck": { "as": "manager", "path": "/rooms/${ROOM}", "jq": ".price == 1100" } }
  ]
}
